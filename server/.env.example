# ldk-server discovery. By default the sidecar reads ldk-server's own config at
#   ~/Library/Application Support/ldk-server/config.toml (macOS) or ~/.ldk-server/config.toml
# and derives the data dir, network, gRPC address, tls.crt and api_key from it.
# LDK_CONFIG=/path/to/ldk-server-config.toml
# LDK_DATA_DIR=/tmp/ldk-server
# LDK_NETWORK=regtest
# LDK_GRPC_ADDRESS=127.0.0.1:3536
# LDK_TLS_CERT_PATH=/tmp/ldk-server/tls.crt
# LDK_API_KEY_PATH=/tmp/ldk-server/regtest/api_key
# LDK_API_KEY=deadbeef...        # hex string, skips the file entirely

# This sidecar
# PORT=8890
# WEB_ORIGIN=http://localhost:3420
# RUST_LOG=info,tower_http=info

# ---- Authentication (REQUIRED unless WALLET_AUTH=off) --------------------------
# Anything that reaches /api/rpc/* can spend from your node. The wallet signs in
# with one password and gets an HttpOnly session cookie.
# WALLET_PASSWORD=change-me
# The URL the browser opens the wallet at. It marks the cookie Secure (https://)
# and is the WebAuthn relying party for passkeys, so it must match exactly.
# Default http://localhost:3420 (Vite dev).
# WALLET_PUBLIC_URL=https://wallet.example.com
# WALLET_SESSION_TTL_HOURS=720
# WALLET_SESSION_SECRET=                          # openssl rand -hex 32; else generated once into WALLET_DATA_DIR

# Where the sidecar keeps passkeys and the generated session secret.
# Default ~/Library/Application Support/mutiny-sidecar (macOS) or ~/.mutiny-sidecar.
# WALLET_DATA_DIR=/var/lib/mutiny-sidecar

# Disable auth entirely. Only for local development: the sidecar then binds
# 127.0.0.1 only, so it cannot be reached off-box.
# WALLET_AUTH=off

# Serve the built web app from the sidecar itself (single-process / Docker).
# WEB_DIR=../dist
