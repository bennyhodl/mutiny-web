{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "preserve",
        "jsxImportSource": "solid-js",
        "noEmit": true,
        "strict": true,
        "types": ["vite/client", "vite-plugin-pwa/client"],
        "paths": {
            "~/*": ["./src/*"]
        },
        "skipLibCheck": true
    },
    "include": [
        "src/**/*",
        "vite.config.ts",
        "capacitor.config.ts",
        "manifest.ts"
    ],
    "exclude": ["node_modules", "dist", "public"]
}
